rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // CATATAN (perbaikan): isOwner()/isAdminKasir() SEKARANG juga mewajibkan
    // is_active != false -- sebelumnya cuma cek role, jadi akun yang sudah
    // dinonaktifkan Owner lain tetap lolos di rule "write" yang HANYA
    // mengandalkan isOwner()/isAdminKasir() tanpa isActiveUser() terpisah
    // (mis. write ke config/users/products/cabang, delete ke counters).
    // UI (auth-guard.js) memang sudah mengunci akun nonaktif dari tampilan
    // aplikasi, tapi itu proteksi client-side saja -- kalau token Auth-nya
    // masih hidup, orang itu tetap bisa memanggil Firestore SDK langsung
    // lewat console browser. Sekarang ditutup juga di level Rules.
    function isOwner() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_active != false;
    }

    function isActiveUser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_active != false;
    }

    // Admin Kasir: role baru pengganti "Karyawan" lama -- akses semua cabang,
    // hanya tidak boleh kelola Akun/Profil Toko/Kelola Cabang (dibatasi
    // di rule masing-masing collection itu, bukan di sini).
    function isAdminKasir() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin_kasir' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_active != false;
    }

    // Owner & Admin Kasir boleh akses data pesanan SEMUA cabang.
    // Karyawan (role baru, per-cabang) hanya boleh akses cabang miliknya sendiri
    // -- ditentukan lewat field cabang_id di dokumen users miliknya.
    function canAccessAllBranches() {
      return isOwner() || isAdminKasir();
    }

    // cabang_id milik user yang sedang login (hanya relevan/terisi untuk role
    // "karyawan"; kosong/null untuk Owner & Admin Kasir).
    function userCabangId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cabang_id;
    }

    // Bandingkan cabang_id sebuah pesanan dengan cabang_id user Karyawan yang
    // sedang login -- TAPI kalau cabang_id user KOSONG (null, misalnya akun
    // Karyawan yang ke-setup tanpa cabang lewat kesalahan input manual di
    // Firestore Console), langsung dianggap TIDAK cocok apa pun isi
    // cabangId-nya. Tanpa ini, pesanan lama yang juga belum punya cabang_id
    // (null) bisa "kebetulan cocok" (null == null) dan malah bisa dibaca
    // Karyawan yang salah setup itu.
    function sameCabang(cabangId) {
      return userCabangId() != null && cabangId == userCabangId();
    }

    // Cabang yang sudah dinonaktifkan Owner (lihat halaman Kelola Cabang)
    // tidak boleh lagi dipakai untuk pesanan BARU oleh Karyawan yang terkunci
    // ke situ -- riwayat pesanan lamanya tetap bisa dibaca seperti biasa
    // (tidak memengaruhi rule "read" di atas, cuma "create" pesanan baru).
    // Kalau dokumen cabangnya sendiri sudah tidak ada (dihapus manual lewat
    // Firestore Console, di luar jalur normal aplikasi), dianggap TIDAK aktif
    // juga (gagal tertutup, bukan gagal terbuka).
    function isCabangActive(cabangId) {
      return exists(/databases/$(database)/documents/cabang/$(cabangId))
        && get(/databases/$(database)/documents/cabang/$(cabangId)).data.get('is_active', true) != false;
    }

    // Menghitung status bayar dari total & jumlah yang sudah dibayar, harus
    // sama persis dengan computeStatusBayar() di js/utils.js. Ini mencegah
    // seseorang mengirim data yang tidak konsisten (mis. status "lunas" tapi
    // paid_amount masih 0) lewat luar aplikasi (mis. console browser).
    function computedStatusBayar(total, paid) {
      return paid <= 0 ? 'belum_bayar' : (paid >= total ? 'lunas' : 'cicilan');
    }

    // Aturan bentuk data pesanan yang berlaku baik saat dibuat maupun diedit.
    //
    // CATATAN KETERBATASAN (keputusan sadar, bukan kelupaan): rules ini TIDAK
    // memvalidasi bahwa "total" benar-benar sama dengan jumlah seluruh
    // items[].subtotal, atau bahwa harga tiap item cocok dengan harga produk
    // yang berlaku -- bahasa Firestore Security Rules tidak punya loop/reduce
    // atas list yang panjangnya dinamis, jadi itu tidak bisa divalidasi di
    // sini tanpa Cloud Function (yang perlu upgrade ke plan Blaze). Karena
    // proyek ini sengaja dibuat 100% gratis tanpa Cloud Function, celah ini
    // diterima sebagai risiko yang dimitigasi lewat DETEKSI di sisi aplikasi
    // saja (lihat hasOrderAnomaly() di js/utils.js, dipakai di Dashboard/
    // Daftar Pesanan/Laporan) -- bukan dicegah di level server. Risikonya
    // terbatas ke staf yang sudah punya akun login (Owner/Admin Kasir/
    // Karyawan) yang sengaja memanggil Firestore langsung lewat console
    // browser, bukan siapa pun dari luar.
    function isValidOrderShape(data) {
      return data.nama_pembeli is string && data.nama_pembeli.size() > 0
        && data.items is list && data.items.size() > 0
        && data.total is number && data.total >= 0
        && data.paid_amount is number && data.paid_amount >= 0
        && data.paid_amount <= data.total
        && data.status_bayar == computedStatusBayar(data.total, data.paid_amount);
    }

    // Validasi dasar untuk create/update produk -- nama wajib diisi, stok
    // (kalau diisi) tidak boleh negatif, waves wajib berbentuk list. SAMA
    // seperti isValidOrderShape() di atas: harga_satuan tiap elemen di dalam
    // "waves" TIDAK divalidasi >= 0 di sini (alasan sama: tidak ada loop atas
    // list dinamis di Security Rules tanpa Cloud Function). Form di
    // produk.html sudah pasang min="0" jadi aman lewat pemakaian normal;
    // risiko sisanya (harga negatif lewat console browser) terbatas ke akun
    // Owner/Admin Kasir yang memang sudah dipercaya kelola harga.
    function isValidProductShape(data) {
      return data.nama is string && data.nama.size() > 0
        && (data.get('stok', null) == null || (data.stok is number && data.stok >= 0))
        && data.waves is list;
    }

    // Field pesanan yang boleh disentuh staf non-Owner (Admin Kasir &
    // Karyawan cabang) saat update -- dua kemungkinan kombinasi field yang
    // berubah sekaligus:
    //  (1) Catat pembayaran / tandai diambil: paid_amount/status_bayar (dari
    //      form Catat Pembayaran) atau is_diambil/tanggal_ambil. paid_amount
    //      WAJIB tidak boleh turun -- tanpa ini, seseorang yang paham
    //      DevTools/console browser bisa memanggil Firestore langsung untuk
    //      mengecilkan/mereset paid_amount, menyembunyikan uang yang sudah
    //      tercatat masuk tanpa jejak (riwayat di subcollection "payments"
    //      tetap ada & tidak bisa disentuh non-Owner, tapi tanpa aturan ini
    //      paid_amount di dokumen pesanan bisa tidak sinkron dengan riwayat
    //      itu).
    //  (2) Edit Pesanan penuh (nama_pembeli/alamat/no_hp/catatan/items/
    //      total/tanggal, plus status_bayar & edit_log yang ikut berubah
    //      otomatis) -- staf non-Owner SEKARANG BOLEH mengedit ini juga
    //      (sebelumnya khusus Owner), tapi TETAP TIDAK BOLEH menyentuh
    //      paid_amount lewat jalur ini (tidak ada di daftar field kombinasi
    //      ini) -- perubahan pembayaran wajib lewat form Catat Pembayaran
    //      di kombinasi (1), bukan dicampur ke sini.
    // Yang TETAP terkunci untuk staf non-Owner terlepas dari 2 kombinasi di
    // atas: Hapus pesanan (lihat "allow delete" di bawah), dan
    // order_no/created_by/created_at/nota_tahun/nota_seq/cabang_id (dikunci
    // permanen untuk SEMUA orang termasuk Owner, dicek terpisah di atas).
    //
    // CATATAN: sama seperti isValidOrderShape() di atas, rules ini TIDAK
    // memvalidasi item-per-item bahwa harga_satuan/product_id/wave_id di tiap
    // baris items memang berasal dari katalog produk yang sah -- Security
    // Rules tidak punya loop atas list yang panjangnya dinamis. Dimitigasi
    // dengan cara yang sama seperti risiko "total" yang sudah diterima
    // sebelumnya: DETEKSI lewat hasOrderAnomaly() + jejak audit di edit_log
    // (ditulis dari sisi aplikasi di js/input-pesanan.js), bukan dicegah di
    // level server.
    //
    // KETERKAITAN paid_amount <-> DOKUMEN PAYMENT (celah "lunas tanpa uang tercatat"):
    // sebelumnya staf non-Owner bisa menaikkan paid_amount langsung (console
    // browser) TANPA membuat dokumen payments apa pun -- piutang hilang padahal
    // tidak ada uang masuk yang tercatat. Aplikasi sekarang menulis
    // `last_payment_id` (id dokumen payment yang dibuat di transaksi yang SAMA)
    // tiap paid_amount naik; rule memastikan dokumen itu (a) BARU -- belum ada
    // sebelum commit, jadi id lama tidak bisa dipakai ulang, (b) ada setelah
    // commit, dan (c) jumlahnya persis sama dengan kenaikan paid_amount.
    //
    // SAKLAR BERTAHAP: selama paymentLinkEnforced() bernilai false, pembatasan
    // ini TIDAK dijalankan (field last_payment_id tetap diterima) -- supaya rules
    // bisa dipublish lebih dulu tanpa mengganggu perangkat yang masih memakai
    // versi aplikasi lama. Ubah jadi true SETELAH semua perangkat memuat versi
    // aplikasi terbaru (lihat langkah rilis di CATATAN-RILIS-RULES.md).
    function paymentLinkEnforced() {
      return false;
    }
    function paymentLinked(orderId, before, after) {
      return after.get('last_payment_id', null) is string
        && after.get('last_payment_id', '').size() > 0
        && !exists(/databases/$(database)/documents/orders/$(orderId)/payments/$(after.get('last_payment_id', 'x')))
        && existsAfter(/databases/$(database)/documents/orders/$(orderId)/payments/$(after.get('last_payment_id', 'x')))
        && getAfter(/databases/$(database)/documents/orders/$(orderId)/payments/$(after.get('last_payment_id', 'x'))).data.jumlah
           == after.get('paid_amount', 0) - before.get('paid_amount', 0);
    }
    // Versi untuk pesanan BARU (create): paid_amount awal > 0 wajib ditopang 1
    // dokumen payment yang dibuat bersamaan. Owner/Admin Kasir dikecualikan di
    // rule create karena fitur Restore Arsip menulis balik pesanan dengan
    // paid_amount = jumlah BEBERAPA payment sekaligus.
    function createPaymentLinked(orderId, data) {
      return data.get('last_payment_id', null) is string
        && data.get('last_payment_id', '').size() > 0
        && existsAfter(/databases/$(database)/documents/orders/$(orderId)/payments/$(data.get('last_payment_id', 'x')))
        && getAfter(/databases/$(database)/documents/orders/$(orderId)/payments/$(data.get('last_payment_id', 'x'))).data.jumlah
           == data.paid_amount;
    }
    function isEmployeeAllowedOrderEdit(orderId, before, after) {
      let keys = after.diff(before).affectedKeys();
      return (keys.hasOnly(['paid_amount', 'status_bayar', 'is_diambil', 'tanggal_ambil', 'last_payment_id'])
              && after.get('paid_amount', 0) >= before.get('paid_amount', 0)
              && (!paymentLinkEnforced()
                  || after.get('paid_amount', 0) == before.get('paid_amount', 0)
                  || paymentLinked(orderId, before, after)))
          || keys.hasOnly(['tanggal', 'nama_pembeli', 'alamat', 'no_hp', 'catatan', 'items', 'total', 'status_bayar', 'edit_log']);
    }

    // Profil toko: nama/alamat/no. HP dipakai juga di halaman status publik
    // (status.html, dibuka lewat scan QR di nota -- lihat js/status.js)
    // supaya bisa menampilkan kop toko & tombol WhatsApp tanpa perlu login.
    // Dibuat match TERPISAH & SESEMPIT MUNGKIN (cuma path persis
    // "config/toko", bukan seluruh koleksi config/*) supaya dokumen config
    // lain (mis. config/migrasi_status, yang isinya status migrasi internal)
    // TETAP tertutup dari akses publik.
    match /config/toko {
      allow get: if true;
    }

    // Profil toko: semua yang login DAN masih aktif boleh baca, hanya Owner boleh ubah.
    match /config/{docId} {
      allow read: if isSignedIn() && isActiveUser();
      allow write: if isOwner();
    }

    // Akun pengguna: tiap orang boleh baca profilnya sendiri, Owner boleh baca/tulis semua.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow write: if isOwner();
      // Fitur "1 sesi login per perangkat": tiap orang boleh update field
      // active_session_id di profilnya SENDIRI saja -- field lain (role,
      // cabang_id, is_active, dst) tetap terkunci, cuma Owner yang boleh
      // ubah itu.
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active_session_id']);
    }

    // Produk & gelombang harga: semua yang login DAN masih aktif boleh baca;
    // Owner & Admin Kasir boleh kelola (tambah/ubah produk & gelombang),
    // Karyawan cabang hanya baca saja.
    match /products/{productId} {
      allow read: if isSignedIn() && isActiveUser();
      allow create, update: if (isOwner() || isAdminKasir()) && isValidProductShape(request.resource.data);
      allow delete: if isOwner() || isAdminKasir();
    }

    // Pengeluaran (Fitur Laporan Keuangan -- Buku Kas & Laba Rugi): semua
    // yang login DAN masih aktif boleh baca, hanya Owner & Admin Kasir boleh
    // catat/ubah/hapus (SAMA seperti Produk di atas -- keputusan Owner:
    // pengeluaran dicatat terpusat, bukan per-cabang, jadi TIDAK ada
    // pembatasan cabang_id seperti di /orders).
    //
    // PERBAIKAN: "read" sebelumnya dibuka untuk SEMUA yang login (termasuk
    // Karyawan cabang) -- padahal halaman Pengeluaran & Laporan Keuangan
    // sudah sengaja dikunci Owner & Admin Kasir saja di sisi UI
    // (data-allowed-roles="owner,admin_kasir" di pengeluaran.html &
    // laporan-keuangan.html), dan sudah dicek TIDAK ADA halaman lain yang
    // butuh Karyawan membaca data ini. Data keuangan (jumlah pengeluaran,
    // kategori) lebih sensitif daripada rekap /stats yang cuma angka jumlah
    // produk -- jadi read juga dikunci ke Owner & Admin Kasir sekarang,
    // supaya Karyawan tidak bisa baca lewat console browser sekalipun.
    // FITUR HUTANG USAHA: pengeluaran sekarang punya paid_amount/status_bayar
    // sendiri, PERSIS pola yang sama dengan /orders di atas (pakai fungsi
    // computedStatusBayar() yang sama) -- supaya pengeluaran yang belum
    // dibayar tunai (mis. beli pupuk secara utang ke pemasok) bisa dicatat
    // & dipantau di Laporan Keuangan, bukan dianggap "sudah lunas" semua
    // seperti sebelumnya. Dokumen /pengeluaran LAMA (dibuat sebelum fitur
    // ini ada) TIDAK PUNYA field ini sama sekali -- itu tidak masalah untuk
    // MEMBACA (Rules tidak memvalidasi bentuk data untuk read, cuma untuk
    // write), sisi klien (js/pengeluaran.js & js/laporan-keuangan.js)
    // menganggap dokumen lama begitu sebagai "lunas" (paid_amount == jumlah)
    // secara default. Field ini WAJIB diisi untuk pencatatan/edit BARU
    // mulai sekarang.
    match /pengeluaran/{pengeluaranId} {
      allow read: if isOwner() || isAdminKasir();
      allow create: if (isOwner() || isAdminKasir())
        && request.resource.data.kategori is string && request.resource.data.kategori.size() > 0
        && request.resource.data.jumlah is number && request.resource.data.jumlah > 0
        && request.resource.data.paid_amount is number && request.resource.data.paid_amount >= 0
        && request.resource.data.paid_amount <= request.resource.data.jumlah
        && request.resource.data.status_bayar == computedStatusBayar(request.resource.data.jumlah, request.resource.data.paid_amount)
        && request.resource.data.created_by == request.auth.uid;
      allow update: if (isOwner() || isAdminKasir())
        && request.resource.data.kategori is string && request.resource.data.kategori.size() > 0
        && request.resource.data.jumlah is number && request.resource.data.jumlah > 0
        && request.resource.data.paid_amount is number && request.resource.data.paid_amount >= 0
        && request.resource.data.paid_amount <= request.resource.data.jumlah
        && request.resource.data.status_bayar == computedStatusBayar(request.resource.data.jumlah, request.resource.data.paid_amount)
        // created_by/created_at (siapa & kapan pertama kali dicatat) terkunci permanen, tidak boleh diganti saat edit.
        && request.resource.data.get('created_by', null) == resource.data.get('created_by', null)
        && request.resource.data.get('created_at', null) == resource.data.get('created_at', null)
        // Whitelist field yang boleh berubah (termasuk riwayat_bayar yang ditulis
        // transaksi Bayar Hutang) -- field lain tidak bisa disisipkan lewat update.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tanggal', 'kategori', 'keterangan', 'jumlah', 'paid_amount', 'status_bayar', 'riwayat_bayar']);
      allow delete: if isOwner() || isAdminKasir();

      // RIWAYAT PEMBAYARAN pengeluaran/hutang (cicilan/pelunasan, masing-masing
      // dengan TANGGAL BAYAR sendiri) -- dasar kas KELUAR di Buku Kas. Jumlah tidak
      // boleh diubah setelah dibuat (koreksi = hapus lalu catat ulang); update cuma
      // untuk menyamakan salinan kategori/keterangan/tanggal-awal saat pengeluaran
      // induknya diedit. Hanya Owner & Admin Kasir, sama seperti /pengeluaran.
      match /pembayaran/{pembayaranId} {
        allow read: if isOwner() || isAdminKasir();
        allow create: if (isOwner() || isAdminKasir())
          && request.resource.data.jumlah is number && request.resource.data.jumlah > 0
          && request.resource.data.tanggal is timestamp
          && request.resource.data.created_by == request.auth.uid
          && existsAfter(/databases/$(database)/documents/pengeluaran/$(pengeluaranId));
        allow update: if (isOwner() || isAdminKasir())
          && request.resource.data.jumlah == resource.data.jumlah
          && request.resource.data.tanggal is timestamp
          && request.resource.data.get('created_by', null) == resource.data.get('created_by', null);
        allow delete: if isOwner() || isAdminKasir();
      }
    }

    // Daftar kategori pengeluaran (dropdown pilihan di halaman Pengeluaran)
    // -- cuma berisi nama kategori, boleh dibaca semua user aktif, dikelola
    // Owner & Admin Kasir. Menghapus kategori di sini TIDAK menghapus/mengubah
    // catatan pengeluaran lama yang sudah memakai nama kategori itu (lihat
    // catatan di js/pengeluaran.js -- kategori disimpan sebagai teks biasa
    // di dokumen /pengeluaran, bukan referensi id ke sini).
    //
    // PERBAIKAN: "read" ikut dikunci Owner & Admin Kasir juga, konsisten
    // dengan /pengeluaran di atas -- daftar KATEGORI pengeluaran saja
    // (tanpa nominal) risikonya jauh lebih rendah daripada data /pengeluaran
    // itu sendiri, tapi tetap tidak ada gunanya dibuka untuk Karyawan yang
    // memang tidak punya akses ke halaman manapun yang memakainya.
    //
    // PERBAIKAN BUG: sebelumnya cuma ada satu `allow write` yang memeriksa
    // request.resource.data.nama. Pada operasi HAPUS, request.resource bernilai
    // null (dokumennya tidak ada lagi setelah operasi), jadi pemeriksaan itu error
    // dan rule dianggap gagal -- akibatnya kategori TIDAK BISA dihapus oleh siapa
    // pun (termasuk Owner). Sekarang tulis (create/update) dan hapus dipisah.
    match /kategori_pengeluaran/{kategoriId} {
      allow read: if isOwner() || isAdminKasir();
      allow create, update: if (isOwner() || isAdminKasir())
        && request.resource.data.keys().hasOnly(['nama'])
        && request.resource.data.nama is string && request.resource.data.nama.size() > 0;
      allow delete: if isOwner() || isAdminKasir();
    }

    // Daftar cabang: semua yang login DAN masih aktif boleh baca (dipakai
    // buat dropdown pilih cabang di Input Pesanan/filter), hanya Owner yang
    // boleh kelola (tambah/ubah/nonaktifkan cabang) lewat halaman "Kelola
    // Cabang".
    match /cabang/{cabangId} {
      allow read: if isSignedIn() && isActiveUser();
      allow write: if isOwner();
    }

    // Rekap jumlah produk per cabang (dipakai Dashboard supaya Karyawan
    // Cabang bisa lihat total lintas cabang TANPA perlu baca detail pesanan
    // cabang lain). Cuma berisi angka, tidak ada nama/HP/alamat pembeli,
    // jadi aman dibaca semua role yang login. Ditulis inkremental dari
    // client (input-pesanan.js/pesanan.js, lewat applyProdukCabangStatsDelta()
    // di js/utils.js) tiap ada pesanan dibuat/diubah/dihapus, plus lewat
    // tombol manual "Hitung Ulang" di Laporan (rebuildProdukCabangStats()).
    // BUKAN divalidasi Cloud Function -- rule "write" di bawah cuma cek
    // role+aktif, tidak memvalidasi bahwa isinya benar-benar angka/berbentuk
    // { [product_id]: { [cabang_id]: number } } (Security Rules tidak bisa
    // memvalidasi map dengan key dinamis tanpa tahu daftar key-nya lebih
    // dulu). Diterima sebagai risiko rendah -- salah paling parah cuma bikin
    // rekap Dashboard salah tampil, tidak menyentuh data pesanan/pembayaran
    // aslinya sama sekali, dan tetap bisa diperbaiki manual lewat "Hitung
    // Ulang" kapan saja.
    //
    // PERBAIKAN: sebelumnya SEMUA user aktif (termasuk Karyawan) boleh
    // menulis APAPUN ke sini, termasuk mengosongkan/mengganti TOTAL isi
    // dokumen (mis. .set({}) tanpa merge) -- artinya Karyawan mana pun bisa
    // sengaja/tidak sengaja menghapus seluruh rekap Dashboard. Sekarang:
    // Owner & Admin Kasir tetap bebas penuh (dipakai fitur "Hitung Ulang" di
    // Laporan yang MENGGANTI TOTAL dari nol lewat .set() TANPA merge --
    // makanya perlu boleh menghapus key lama). Role lain (Karyawan) TETAP
    // boleh menulis -- WAJIB tetap bisa, karena applyProdukCabangStatsDelta()
    // dipanggil DI DALAM transaksi yang sama dengan create/edit pesanan
    // milik Karyawan sendiri; kalau ditolak total, transaksi pesanannya ikut
    // gagal tersimpan -- TAPI tidak boleh menghapus key level-atas yang
    // sudah ada (cuma boleh menambah produk baru / mengubah angka yang ada,
    // via increment()), supaya tidak bisa mengosongkan rekap produk/cabang
    // lain. `resource == null` mengizinkan penulisan dokumen ini untuk
    // PERTAMA KALINYA (belum ada key untuk dihapus).
    match /stats/{docId} {
      allow read: if isSignedIn() && isActiveUser();
      allow write: if isSignedIn() && isActiveUser()
        && (isOwner() || isAdminKasir()
            || resource == null
            || request.resource.data.diff(resource.data).removedKeys().size() == 0);
    }


    // Penomoran otomatis pesanan. Hanya field "seq" (angka) yang boleh
    // ditulis, dan nilainya wajib naik -- mencegah nomor nota/urut dirusak
    // atau dimundurkan (yang bisa menyebabkan nomor nota bentrok/duplikat).
    match /counters/{counterId} {
      allow read: if isSignedIn() && isActiveUser();

      // Counter baru selalu mulai dari 1, dan tiap kenaikan HARUS tepat +1 --
      // persis seperti yang dilakukan aplikasi (input-pesanan.js &
      // assignLegacyNotaSeqAtomic di utils.js selalu "seq + 1"). Sebelumnya
      // syaratnya cuma "lebih besar dari sebelumnya", jadi akun mana pun (termasuk
      // Karyawan, lewat console browser) bisa melompatkan nomor nota ke angka
      // berapa pun. Sekarang lompatan bebas (mis. mengatur ulang awal nomor)
      // cuma boleh Owner. Sisa celah: akun lain masih bisa "membuang" nomor satu
      // per satu (nomor jadi bolong) -- tidak bisa loncat & tidak bisa bentrok;
      // menutup ini sepenuhnya butuh server (Cloud Functions), tidak tersedia
      // di tier gratis.
      allow create: if isSignedIn() && isActiveUser()
        && request.resource.data.keys().hasOnly(['seq'])
        && request.resource.data.seq is number
        && request.resource.data.seq > 0
        && (isOwner() || request.resource.data.seq == 1);

      allow update: if isSignedIn() && isActiveUser()
        && request.resource.data.keys().hasOnly(['seq'])
        && request.resource.data.seq is number
        && (request.resource.data.seq == resource.data.seq + 1
            || (isOwner() && request.resource.data.seq > resource.data.seq));

      allow delete: if isOwner();
    }

    // Riwayat Arsip PO (backup/hapus/restore) -- CUMA berisi metadata (nama
    // file, jumlah pesanan, ringkasan filter, status), BUKAN data pesanan
    // itu sendiri (itu ada di file JSON yang diunduh user, bukan di
    // Firestore) -- jadi ringan & aman dibaca Owner/Admin Kasir. Owner &
    // Admin Kasir sama-sama boleh Backup & Restore (lihat halaman Arsip PO),
    // tapi HAPUS permanen pesanan tetap cuma lewat rule "delete" di
    // /orders/{orderId} di bawah yang sudah cuma Owner -- dokumen di sini
    // cuma pencatat status "sudah_dihapus"/"utuh", bukan yang benar-benar
    // menghapus data.
    match /arsip_log/{docId} {
      allow read: if isSignedIn() && isActiveUser() && canAccessAllBranches();
      allow create: if isSignedIn() && isActiveUser() && canAccessAllBranches()
        && request.resource.data.dibuat_oleh == request.auth.uid
        && request.resource.data.nama_file is string && request.resource.data.nama_file.size() > 0
        && request.resource.data.jumlah_pesanan is number && request.resource.data.jumlah_pesanan >= 0;
      // Update dibatasi cuma untuk mengubah status (sudah_dihapus/utuh) &
      // info terkait -- nama_file dan dibuat_oleh (siapa pembuat asli
      // backup-nya) tidak boleh diubah lagi setelah dibuat.
      allow update: if isSignedIn() && isActiveUser() && canAccessAllBranches()
        && request.resource.data.nama_file == resource.data.nama_file
        && request.resource.data.dibuat_oleh == resource.data.dibuat_oleh
        // Whitelist: cuma field status/jejak hapus & restore yang boleh berubah
        // (persis yang ditulis js/arsip.js) -- field lain tidak bisa disisipkan.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dihapus_at', 'dihapus_oleh', 'dihapus_oleh_nama', 'direstore_at', 'direstore_oleh', 'direstore_oleh_nama']);
      allow delete: if isOwner();
    }

    // Pesanan: user aktif boleh baca & buat pesanan baru -- TAPI dibatasi
    // per-cabang untuk role "karyawan" (lihat canAccessAllBranches() di atas):
    // Owner & Admin Kasir bebas semua cabang, Karyawan cabang lain SAMA SEKALI
    // tidak bisa membaca/menyentuh pesanan cabang lain, walau lewat cara lain
    // di luar tampilan aplikasi (mis. console browser / akses API langsung).
    // Setelah pesanan dibuat: Owner bebas mengubah; Admin Kasir & Karyawan boleh
    // (1) catat pembayaran & tandai diambil, dan (2) Edit Pesanan (data pembeli/
    // item/total) -- lihat isEmployeeAllowedOrderEdit() -- masing-masing hanya
    // di cabang yang boleh mereka akses. Hapus pesanan dibatasi khusus Owner.
    // Khusus untuk collectionGroup("payments") -- dipakai Buku Kas di halaman
    // Laporan Keuangan untuk baca riwayat pembayaran dari SEMUA pesanan
    // sekaligus (lintas cabang), BUKAN payments 1 pesanan tertentu. Aturan
    // "match /orders/{orderId}/payments/{paymentId}" di bawah (di dalam
    // match /orders/{orderId}) TIDAK berlaku untuk query collectionGroup --
    // Firestore mewajibkan format wildcard rekursif {path=**} terpisah
    // khusus untuk itu, walau path dokumennya sama persis. Dibatasi Owner &
    // Admin Kasir saja (canAccessAllBranches()) -- TIDAK dibuka untuk
    // Karyawan cabang karena halaman Laporan Keuangan sendiri sudah
    // dibatasi Owner+Admin Kasir saja (data-allowed-roles di
    // laporan-keuangan.html) dan tidak ada bagian lain aplikasi yang
    // memakai collectionGroup("payments").
    match /{path=**}/payments/{paymentId} {
      allow read: if isSignedIn() && isActiveUser() && canAccessAllBranches();
    }

    // Sama seperti di atas, untuk collectionGroup("pembayaran") -- riwayat
    // pembayaran PENGELUARAN lintas semua catatan, dipakai Buku Kas (kas keluar
    // per tanggal bayar). Nama koleksinya SENGAJA beda dari "payments" supaya
    // tidak tercampur ke kas masuk.
    match /{path=**}/pembayaran/{pembayaranId} {
      allow read: if isSignedIn() && isActiveUser() && (isOwner() || isAdminKasir());
    }

    // Status pesanan publik (fitur QR code di nota A4, lihat js/status.js &
    // buildPublicOrderStatusData() di js/utils.js) -- ringkasan pesanan yang
    // SENGAJA dipisah dari /orders supaya bisa dibaca SIAPA SAJA tanpa login
    // (dibuka lewat scan QR di nota fisik), TAPI isinya sudah sengaja
    // dipangkas di sisi aplikasi (alamat & no_hp penuh, cabang_id, created_by,
    // edit_log semua TIDAK ikut disalin -- lihat komentar di utils.js) supaya
    // ID pesanan yang bocor/ketebak cuma membuka ringkasan status, bukan data
    // pribadi lengkap. "get" (baca 1 dokumen by ID) dibuka untuk semua orang;
    // "list" (query/enumerasi seluruh koleksi) TETAP DITUTUP -- tanpa tahu ID
    // persis (dari QR/link), tidak ada cara melihat daftar pesanan siapa pun.
    // Penulisan tetap wajib login (hanya aplikasi yang menulis ke sini,
    // dipanggil bersamaan dengan penulisan ke /orders -- lihat titik-titik
    // panggilan di js/input-pesanan.js & js/pesanan.js).
    match /orders_public/{orderId} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn() && isActiveUser();
    }

    match /orders/{orderId} {
      // Pakai .get('cabang_id', null) (bukan akses langsung) supaya pesanan
      // lama dari sebelum fitur cabang ada (belum punya cabang_id) tidak bikin
      // rule error -- otomatis dianggap "belum ada cabangnya" (null) sampai
      // dimigrasi lewat halaman Kelola Cabang.
      allow read: if isSignedIn() && isActiveUser()
        && (canAccessAllBranches() || sameCabang(resource.data.get('cabang_id', null)));

      // Saat pesanan baru dibuat: created_by wajib sama dengan yang login
      // (tidak bisa mengaku-aku sebagai karyawan lain), cabang_id wajib diisi,
      // dan kalau yang input Karyawan cabang: cabang_id WAJIB sama dengan
      // cabang_id akunnya sendiri (tidak bisa input atas nama cabang lain)
      // DAN cabang itu wajib masih aktif (Owner belum menonaktifkannya).
      // Admin Kasir/Owner tidak kena batasan cabang aktif ini -- mereka boleh
      // tetap mencatat pesanan susulan/koreksi untuk cabang yang sudah tutup
      // kalau memang perlu.
      // CATATAN (fitur Arsip PO / Restore): created_by NORMALNYA wajib sama
      // dengan yang login (baris di bawah) -- TAPI fitur Restore di halaman
      // Arsip PO perlu menulis balik pesanan LAMA dengan created_by ASLI
      // (siapapun yang dulu membuatnya, bukan Owner/Admin Kasir yang sedang
      // menekan tombol Restore sekarang), supaya riwayat pesanan tetap
      // akurat. Makanya Owner & Admin Kasir (canAccessAllBranches()) boleh
      // membuat dokumen dengan created_by APAPUN, tidak cuma dirinya sendiri
      // -- staf Karyawan cabang (yang tidak punya akses Arsip PO) tetap
      // wajib created_by == dirinya sendiri seperti sebelumnya.
      allow create: if isSignedIn() && isActiveUser()
        && isValidOrderShape(request.resource.data)
        && (request.resource.data.created_by == request.auth.uid || canAccessAllBranches())
        && request.resource.data.cabang_id is string && request.resource.data.cabang_id.size() > 0
        && (canAccessAllBranches()
            || (sameCabang(request.resource.data.cabang_id) && isCabangActive(request.resource.data.cabang_id)))
        && (!paymentLinkEnforced()
            || canAccessAllBranches()
            || request.resource.data.paid_amount == 0
            || createPaymentLinked(orderId, request.resource.data));

      // order_no/created_by/created_at/nota_tahun/nota_seq tidak boleh
      // berubah oleh siapa pun (termasuk Owner) -- itu identitas & nomor
      // nota permanen milik pesanan. cabang_id juga terkunci permanen setelah
      // terisi (pesanan tidak bisa dipindah cabang), TAPI kalau pesanan lama
      // belum punya cabang_id (null), boleh diisi SEKALI -- dipakai fitur
      // migrasi data lama di halaman Kelola Cabang -- begitu sudah terisi,
      // langsung terkunci permanen seperti nota_tahun/nota_seq. Karyawan/Admin
      // Kasir (bukan Owner) tambahan lagi hanya boleh menyentuh field
      // pembayaran & status pengambilan, dan hanya untuk pesanan di cabang
      // yang boleh mereka akses.
      allow update: if isSignedIn() && isActiveUser()
        && isValidOrderShape(request.resource.data)
        && request.resource.data.get('created_by', null) == resource.data.get('created_by', null)
        && request.resource.data.get('order_no', null) == resource.data.get('order_no', null)
        && request.resource.data.get('created_at', null) == resource.data.get('created_at', null)
        && (resource.data.get('nota_tahun', null) == null || request.resource.data.nota_tahun == resource.data.nota_tahun)
        && (resource.data.get('nota_seq', null) == null || request.resource.data.nota_seq == resource.data.nota_seq)
        && (resource.data.get('cabang_id', null) == null || request.resource.data.cabang_id == resource.data.cabang_id)
        && (canAccessAllBranches() || sameCabang(resource.data.get('cabang_id', null)))
        && (isOwner() || isEmployeeAllowedOrderEdit(orderId, resource.data, request.resource.data));

      allow delete: if isOwner();

      match /payments/{paymentId} {
        // Baca/tulis riwayat pembayaran ikut dibatasi ke cabang pesanan
        // induknya (dicek lewat get() ke dokumen orders/{orderId}), supaya
        // Karyawan cabang lain juga tidak bisa mengintip lewat subcollection
        // ini secara langsung.
        allow read: if isSignedIn() && isActiveUser()
          && (canAccessAllBranches()
              || sameCabang(get(/databases/$(database)/documents/orders/$(orderId)).data.get('cabang_id', null)));
        // Sama seperti catatan Restore di rule "create" pesanan di atas:
        // Owner & Admin Kasir boleh menulis balik riwayat pembayaran LAMA
        // dengan created_by asli (bukan cuma dirinya sendiri) supaya fitur
        // Restore di halaman Arsip PO bisa memulihkan data persis semula.
        //
        // PERBAIKAN: `!exists(orders/{orderId})` ditambahkan di baris cabang
        // di bawah. Sebabnya: saat pesanan BARU dibuat SEKALIGUS DENGAN
        // pembayaran awalnya (uang muka > 0 langsung saat Input Pesanan),
        // keduanya ditulis DALAM 1 TRANSAKSI yang sama -- tapi Security
        // Rules TIDAK BISA melihat dokumen pesanan yang baru saja ditulis di
        // transaksi yang sama itu lewat get(), jadi dari sudut pandang rule
        // ini pesanan induknya "belum ada" sama sekali. Untuk Owner/Admin
        // Kasir tidak masalah (canAccessAllBranches() lolos duluan lewat
        // "||", baris get() di bawah tidak pernah dievaluasi) -- TAPI untuk
        // Karyawan cabang, get() ini gagal/menganggap dokumennya tidak ada,
        // sehingga PENULISAN PEMBAYARAN PERTAMA DITOLAK -- Karyawan jadi
        // "terpaksa" simpan pesanan dengan bayar Rp0 dulu, baru catat
        // pembayaran terpisah belakangan (yang BERHASIL karena saat itu
        // pesanannya sudah benar-benar ada/ter-commit, get()-nya sukses).
        // Kalau pesanan induknya BELUM ADA (skenario "dibuat bersamaan"
        // persis di atas), cabang KARYAWAN sudah pasti benar dengan
        // sendirinya -- itu sudah dijamin oleh rule "create" PESANAN di atas
        // (match /orders/{orderId}) yang MEWAJIBKAN sameCabang() untuk
        // Karyawan sebelum pesanannya sendiri boleh tersimpan, dalam
        // transaksi yang persis sama. Jadi aman dilewati di sini KHUSUS
        // untuk kasus itu -- kalau pesanan induknya SUDAH ADA (skenario
        // normal: Catat Pembayaran belakangan lewat Detail Pesanan untuk
        // pesanan yang sudah lama tersimpan), pengecekan cabang tetap
        // berjalan seperti biasa lewat get() yang sekarang berhasil.
        //
        // PERBAIKAN LANJUTAN (celah "payment yatim"): `!exists(...)` di atas
        // ternyata membuat SIAPA PUN yang login bisa menulis payments/{id} di bawah
        // pesanan yang TIDAK ADA sama sekali (dokumen yatim yang lalu ikut terbaca
        // Buku Kas lewat collectionGroup). Diganti existsAfter()/getAfter(): kedua
        // fungsi ini membaca kondisi SETELAH seluruh batch/transaksi ter-commit,
        // jadi pesanan yang dibuat BERSAMAAN dengan pembayaran awalnya (1 transaksi)
        // ikut terlihat -- tidak seperti get()/exists() biasa yang cuma melihat
        // kondisi sebelum commit. Hasilnya: pembayaran wajib punya pesanan induk yang
        // benar-benar ada, dan cabang Karyawan tetap dicek ke pesanan induk itu.
        allow create: if isSignedIn() && isActiveUser()
          && request.resource.data.jumlah is number
          && request.resource.data.jumlah > 0
          && (request.resource.data.created_by == request.auth.uid || canAccessAllBranches())
          && existsAfter(/databases/$(database)/documents/orders/$(orderId))
          && (canAccessAllBranches()
              || sameCabang(getAfter(/databases/$(database)/documents/orders/$(orderId)).data.get('cabang_id', null)));
        allow update, delete: if isOwner();
      }
    }

    // (Perbaikan tahap 13: blok ini dulu ADA DUA -- lihat catatan panjang di
    // atas dekat "match /{path=**}/payments/{paymentId}" pertama. Isinya
    // 100% sama (canAccessAllBranches() == isOwner() || isAdminKasir()),
    // jadi digabung jadi satu; tidak ada perubahan izin akses.)
  }
}